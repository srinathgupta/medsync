// secrets.h — copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is listed in .gitignore so your passwords are never uploaded.
#pragma once

// Up to 3 Wi-Fi networks; leave "" to skip a slot.
const WifiCred WIFI_LIST[] = {
  { "YOUR_WIFI_NAME",    "YOUR_WIFI_PASSWORD" },
  { "",                  ""                   },   // e.g. phone hotspot
  { "",                  ""                   },   // e.g. college
};

// Firebase project (Project settings -> General -> Web app config)
#define API_KEY       "YOUR_FIREBASE_WEB_API_KEY"
#define DATABASE_URL  "https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app/"

// Recommended: one Email/Password user for the device (Firebase Console -> Authentication).
// Leave both "" to use anonymous sign-in.
#define DEVICE_EMAIL     ""
#define DEVICE_PASSWORD  ""
